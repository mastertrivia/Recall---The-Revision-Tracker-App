<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon for Recall. The foreground artwork is the user's
     workspace logo (Recall App Logo .png) centred inside the 66/108 safe zone;
     the background is its own dark navy so mask cropping never cuts the mark. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/recall_icon_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>